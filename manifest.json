{
  "manifestVersion": 5,
  "id": "com.siez.cs2playeroverlay",
  "name": "CS2 Player Overlay",
  "version": "1.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "playerPanel",
      "label": {
        "default": "CS2 Player Overlay"
      },
      "minimumSize": {
        "width": 300,
        "height": 380
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 650
      }
    }
  ]
}